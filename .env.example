# coincall-gateway 数据面配置（env 前缀 COINCALL_）
COINCALL_PORT=8030
COINCALL_DUCKDB_PATH=data/gateway.duckdb
# 管理面（coincall-core，8020）
COINCALL_CORE_BASE_URL=http://127.0.0.1:8020
# 影子闸门并发上限（02 §5c，默认 3）
COINCALL_SHADOW_K=3
# PayVault 合约（EIP-712 verifyingContract；事实源 coincall-contracts/deployments/testnet-968.json）
COINCALL_PAY_VAULT_ADDRESS=0xFe91F55C0e7Ccbc4A6619C67544Ab453cf79C471
# 链上约束（只读 eth_call）
COINCALL_CHAIN_RPC_URL=https://rpc.bohr.life/
COINCALL_CHAIN_ID=968
# 计价 token = MockUSDT（与 PayVault 部署绑定）
COINCALL_PAYMENT_TOKEN_ADDRESS=0x4F8f2eaAA3988E9f59B72C93262DDC1084E540fb
# 收据 HMAC 密钥（生产必须改）
COINCALL_RECEIPT_SECRET=change-me
