# coincall-core 管理面配置（env 前缀 COINCALL_CORE_）
COINCALL_CORE_PORT=8020
COINCALL_CORE_DUCKDB_PATH=data/core.duckdb
# 探测出网代理（/services/probe 的 httpx 客户端 trust_env=True 读取进程环境变量；
# 需在启动 core 的命令前导出，写入本文件不会被 pydantic-settings 导出到 os.environ）
# HTTPS_PROXY=http://127.0.0.1:7890  # 探测外部上游经代理；NO_PROXY 需含 127.0.0.1,localhost 保本机服务直连
# NO_PROXY=127.0.0.1,localhost
