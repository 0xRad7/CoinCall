# ==== BOT Chain API 环境变量样例（复制为 .env 使用；.env 永不入库）====

# 网络选择：testnet（默认，Chain ID 968）| mainnet（677，还需下方双重锁）
BOT_CHAIN_NETWORK=testnet
# 主网双重锁：设为 1 才允许 mainnet（默认禁用）
BOT_CHAIN_ALLOW_MAINNET=

# 测试网出资私钥（仅允许测试网私钥！接口/日志永不回显全文）
# 领水：https://faucet.bohr.life/basic
BOT_CHAIN_TEST_PRIVATE_KEY=

# 服务代管账户 keystore 加密口令（未设置则进程内临时态，重启后代管私钥不可恢复）
BOT_CHAIN_KEYSTORE_SECRET=

# 可选：Redis 连接（未设置则降级为进程锁/内存幂等/进程内 SSE 总线）
# REDIS_URL=redis://localhost:6379/0

# 可选：DuckDB 路径（默认 data/botchain.duckdb）
# DUCKDB_PATH=data/botchain.duckdb

# 可选：API 鉴权（设置后所有 /api 请求需带 X-API-Key 头，现场公网演示时开启）
# BOT_CHAIN_API_KEY=

# 可选：代理（仅 botchain.ai 主网域需要；*.bohr.life 直连不走代理）
# PROXY=http://127.0.0.1:7890
