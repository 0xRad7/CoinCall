# coincall-gateway 数据面配置（env 前缀 COINCALL_）
COINCALL_PORT=8030
COINCALL_DUCKDB_PATH=data/gateway.duckdb
# 管理面（coincall-core，8020）
COINCALL_CORE_BASE_URL=http://127.0.0.1:8020
# 影子闸门并发上限（02 §5c，默认 3）
COINCALL_SHADOW_K=3
# PayVault 合约（EIP-712 verifyingContract；事实源 coincall-contracts/deployments/testnet-968.json）
COINCALL_PAY_VAULT_ADDRESS=0xa6E82Fd6648F9Ea8f695c37Edf89f2E5FDb89ff0
# 链上约束（只读 eth_call）
COINCALL_CHAIN_RPC_URL=https://rpc.bohr.life/
COINCALL_CHAIN_ID=968
# 计价 token = 测试网 USDT（epoch2）
COINCALL_PAYMENT_TOKEN_ADDRESS=0x75edC9335175Fc0552D51D48439F229c10420fe3
# 收据 HMAC 密钥（生产必须改）
COINCALL_RECEIPT_SECRET=change-me
# ---- keeper 结算器（04 §3 / 09 P0-5）----
# 常驻结算任务开关（单测默认关；生产/演示置 true——gateway 进程内自动续批）
COINCALL_KEEPER_ENABLED=true
# 攒批笔数阈值（演示故意取小，Charged 事件快速上屏）；上链单笔硬上限 50=合约 MAX_BATCH
COINCALL_KEEPER_BATCH_SIZE=3
# 攒批时间阈值（秒）：未满一批但最老一笔等待超过该值即上链
COINCALL_KEEPER_FLUSH_INTERVAL=30
# operator 地址 = PayVault 唯一提交人（由 bot-chain-api keystore 代管签名，本服务不持私钥）
COINCALL_KEEPER_OPERATOR_ADDRESS=0xC37fFE97B4D2C3D0187B1dDEDF273E52A461B63a
# bot-chain-api（链上提交/回执/只读探测的唯一通道，铁律 P1）
COINCALL_BOT_CHAIN_API_BASE_URL=http://127.0.0.1:8010
# provider 记账钱包静态覆盖（agent_id → agentWallet JSON；缺省走 core manifest 解析）
COINCALL_KEEPER_PROVIDER_WALLET_OVERRIDES={}

