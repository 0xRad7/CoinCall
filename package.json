{
  "name": "coincall-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CoinCall 控制台：服务端配置与消费端配置的一站式 Web UI（本地运行，零 CDN）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
